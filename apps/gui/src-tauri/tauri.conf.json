{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameRush",
  "version": "0.1.0",
  "identifier": "io.github.brodriro.framerush",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FrameRush",
        "width": 420,
        "height": 760,
        "minWidth": 420,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
